{
  "name": "auto-breakthrough",
  "version": "1.0.0",
  "description": "Autonomous research skill & CLI that turns a thesis and an experiment into a verdict",
  "type": "module",
  "main": "./src/index.mjs",
  "bin": {
    "auto-breakthrough": "./bin/auto-breakthrough.mjs"
  },
  "scripts": {
    "start": "node ./src/server.mjs",
    "server": "node ./src/server.mjs",
    "frontend": "node ./src/server.mjs",
    "dev": "node ./src/server.mjs",
    "cli": "node ./bin/auto-breakthrough.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node ./bin/auto-breakthrough.mjs run --example critique",
    "demo:all": "node ./bin/auto-breakthrough.mjs examples --all"
  },
  "keywords": [
    "ai",
    "research",
    "agent",
    "thesis",
    "experiment",
    "verdict",
    "falsifiability",
    "scientific-method",
    "autonomous-loop"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "sadhasri697",
  "repository": {
    "type": "git",
    "url": "https://github.com/SadhaSri697/Auto-breaktrough-main.git"
  },
  "homepage": "https://github.com/SadhaSri697/Auto-breaktrough-main#readme",
  "bugs": {
    "url": "https://github.com/SadhaSri697/Auto-breaktrough-main/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
